# Local Docker: docker compose up -d
# Production: Vercel Storage → Connect Supabase, or paste the Transaction pooler URI (port 6543)
# The app also reads POSTGRES_URL / POSTGRES_PRISMA_URL from the Vercel × Supabase integration
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/bailamos

# Payload secret used to sign auth cookies — generate a long random string in production
PAYLOAD_SECRET=change-me

# Set to true only for a one-off schema push against a fresh database
PAYLOAD_PUSH=false

# Public URL of the site (used for metadata / canonical / hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible analytics (leave empty to disable tracking)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible instance
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# Supabase Storage (S3). Leave empty locally to keep uploads in /media
# Create a public bucket named media, then Storage → S3 access keys
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
