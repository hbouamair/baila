# Canonical site URL for metadata, Open Graph, sitemap and hreflang (server-only Config)
SITE_URL=https://bailaimosbachatafestival.com

# Plausible analytics (leave empty to disable tracking)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted Plausible instance
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# Supabase (project bailaimos). Vercel: Config for URL, Secret for keys/passwords.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_PASSWORD=
